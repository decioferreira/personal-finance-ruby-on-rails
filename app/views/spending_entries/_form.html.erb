<%= form_with(model: spending_entry) do |form| %>
  <% if spending_entry.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(spending_entry.errors.count, "error") %> prohibited this spending_entry from being saved:</h2>

      <ul>
        <% spending_entry.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :date, style: "display: block" %>
    <%= form.date_field :date %>
  </div>

  <div>
    <%= form.label :amount, style: "display: block" %>
    <%= form.number_field :amount, step: "0.01", min: "0.01" %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description %>
  </div>

  <div>
    <%= form.label :category_id, "Category", style: "display: block" %>
    <%= form.collection_select :category_id, Current.user.categories.order(:name), :id, :name, prompt: true %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
