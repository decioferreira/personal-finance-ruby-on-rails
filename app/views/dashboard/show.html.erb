<% content_for :title, "Dashboard" %>

<div class="w-full max-w-4xl mx-auto">
  <%= render "shared/notice" %>

  <%= render "shared/month_nav", month: @month, prev_path: root_path(month: @month.prev_month), next_path: root_path(month: @month.next_month) %>

  <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm font-medium text-gray-500">Income</p>
      <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@income&.amount || 0) %></p>
      <% if @income %>
        <%= link_to "Edit income", edit_monthly_income_path(@income), class: "mt-3 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <% else %>
        <%= link_to "Add income", new_monthly_income_path(month: @month), class: "mt-3 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <% end %>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm font-medium text-gray-500">Spent</p>
      <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@total_spent) %></p>
    </div>

    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm font-medium text-gray-500">Remaining</p>
      <p class="mt-2 text-2xl font-semibold <%= @remaining.negative? ? "text-red-600" : "text-gray-900" %>"><%= number_to_currency(@remaining) %></p>
    </div>
  </div>

  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5"
       data-controller="dashboard"
       data-dashboard-category-totals-value="<%= @category_totals.map { |name, amount| { category: name, amount: amount.to_s } }.to_json %>">
    <h2 class="mb-4 text-lg font-semibold text-gray-900">Spending by category</h2>

    <% if @category_totals.any? %>
      <div class="grid grid-cols-1 items-center gap-6 sm:grid-cols-2">
        <div class="mx-auto w-full max-w-[240px]">
          <canvas data-dashboard-target="canvas"></canvas>
        </div>

        <ul class="space-y-2">
          <% @category_totals.each do |name, amount| %>
            <li class="flex items-center justify-between text-sm">
              <span class="text-gray-700"><%= name %></span>
              <span class="font-medium text-gray-900">
                <%= number_to_currency(amount) %>
                <span class="text-gray-400">(<%= number_to_percentage(amount / @total_spent * 100, precision: 0) %>)</span>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="py-8 text-center text-sm text-gray-500">No spending recorded for this month yet.</p>
    <% end %>
  </div>
</div>
