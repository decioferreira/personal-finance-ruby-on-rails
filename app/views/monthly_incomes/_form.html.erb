<%= form_with(model: monthly_income) do |form| %>
  <% if monthly_income.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(monthly_income.errors.count, "error") %> prohibited this income from being saved:</h2>

      <ul>
        <% monthly_income.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :month, style: "display: block" %>
    <%= form.date_field :month %>
  </div>

  <div>
    <%= form.label :amount, style: "display: block" %>
    <%= form.number_field :amount, step: "0.01", min: "0" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
